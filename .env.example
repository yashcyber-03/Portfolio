# Public (safe in the browser): shown as the mailto fallback and email link.
VITE_CONTACT_EMAIL=you@example.com

# Private (server only, set in Vercel > Settings > Environment Variables).
# Used by api/contact.js to send form messages through Resend (resend.com).
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
